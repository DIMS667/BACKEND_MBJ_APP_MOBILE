# Copier en .env et renseigner les vraies valeurs.
# Ne jamais committer le .env réel (déjà dans .gitignore).

# Base de données — Postgres, driver asyncpg obligatoire (asyncpg, pas psycopg2)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# JWT — générer une clé dédiée à CHAQUE environnement, ne jamais réutiliser
# celle du dev en production : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Serveur
HOST=0.0.0.0
PORT=8000
# False en production : True active l'echo SQL complet (chaque requête +
# paramètres loggés) et n'est destiné qu'au développement local.
DEBUG=False

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10

# CORS — n'a aucun effet sur l'app mobile (CORS ne s'applique qu'aux
# navigateurs, pas aux clients HTTP natifs) : liste vide tant qu'aucun
# site web ne consomme cette API. Si un site web est ajouté un jour,
# lister ses origines exactes ici (ex: ["https://app.maisonbleue.fr"])
# — jamais ["*"] en production.
ALLOWED_ORIGINS=[]

# Pool de connexions DB — à ajuster selon la limite max_connections du plan
# Postgres de l'hébergeur, en tenant compte du nombre de workers Passenger
# (chaque worker ouvre jusqu'à DB_POOL_SIZE + DB_MAX_OVERFLOW connexions).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
